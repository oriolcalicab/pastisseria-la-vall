generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------
enum Role {
  customer
  admin
}

enum OrderStatus {
  pending
  preparing
  ready
  delivered
  cancelled
}

enum DeliveryMethod {
  delivery
  pickup
}

// ---------- Usuaris ----------
model User {
  id          Int      @id @default(autoincrement())
  firebaseUid String   @unique @map("firebase_uid")
  name        String
  email       String   @unique
  role        Role     @default(customer)
  createdAt   DateTime @default(now()) @map("created_at")

  orders        Order[]
  statusChanges OrderStatusHistory[]

  @@map("users")
}

// ---------- Catàleg ----------
model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @map("category_id")
  name         String
  description  String
  imageUrl     String?  @map("image_url")
  isGlutenFree Boolean  @default(false) @map("is_gluten_free")
  isPlantMilk  Boolean  @default(false) @map("is_plant_milk")
  isVegan      Boolean  @default(false) @map("is_vegan")
  allergens    String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([categoryId, isActive])
  @@map("products")
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int     @map("product_id")
  name       String
  priceCents Int     @map("price_cents")
  stock      Int
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ---------- Recollida i calendari ----------
model PickupPoint {
  id           Int     @id @default(autoincrement())
  name         String
  address      String
  city         String
  latitude     Decimal @db.Decimal(9, 6)
  longitude    Decimal @db.Decimal(9, 6)
  openingHours String  @map("opening_hours")
  isActive     Boolean @default(true) @map("is_active")

  orders Order[]

  @@map("pickup_points")
}

model ClosedDate {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique @db.Date
  reason String

  @@map("closed_dates")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

// ---------- Comandes ----------
model Order {
  id                 Int            @id @default(autoincrement())
  orderNumber        String         @unique @map("order_number")
  idempotencyKey     String         @map("idempotency_key")
  userId             Int            @map("user_id")
  status             OrderStatus    @default(pending)
  deliveryMethod     DeliveryMethod @map("delivery_method")
  deliveryDate       DateTime       @map("delivery_date") @db.Date
  pickupPointId      Int?           @map("pickup_point_id")
  shippingAddress    String?        @map("shipping_address")
  shippingCity       String?        @map("shipping_city")
  shippingPostalCode String?        @map("shipping_postal_code")
  subtotalCents      Int            @map("subtotal_cents")
  shippingCents      Int            @map("shipping_cents")
  totalCents         Int            @map("total_cents")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id])
  pickupPoint   PickupPoint?         @relation(fields: [pickupPointId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([deliveryDate, status])
  @@map("orders")
}

model OrderItem {
  id             Int    @id @default(autoincrement())
  orderId        Int    @map("order_id")
  variantId      Int    @map("variant_id")
  productName    String @map("product_name")
  variantName    String @map("variant_name")
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int    @map("line_total_cents")

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int          @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  Int          @map("changed_by")
  changedAt  DateTime     @default(now()) @map("changed_at")

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [changedBy], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}
